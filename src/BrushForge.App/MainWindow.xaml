<Window x:Class="BrushForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrushForge by Strissel"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#17191D">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#262A31" />
            <Setter Property="BorderBrush" Value="#454B55" />
            <Setter Property="CaretBrush" Value="#F5F7FA" />
        </Style>
        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#262A31" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#3B4657" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#46566D" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="#7C8490" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#262A31" />
            <Setter Property="BorderBrush" Value="#454B55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ControlBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="#DCE2EA" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#262A31"
                                        BorderBrush="#59616E"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="ControlBorder"
                                        Property="BorderBrush"
                                        Value="#7B90AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ControlBorder"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickPlacement" Value="None" />
        </Style>        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#3B4657" />
            <Setter Property="BorderBrush" Value="#59677B" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,16">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="BrushForge Foliage Generator" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#AEB6C2"
                       Text="Generate real low-complexity brush trees and export them to TrenchBroom-compatible Valve 220 maps." />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.Column="0"
                Padding="16"
                Background="#202329"
                BorderBrush="#383D46"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Tree Parameters" />

                    <TextBlock Margin="0,14,0,0"
                               Text="Generation seed" />
                    <TextBox x:Name="GenerationSeedTextBox"
                             Margin="0,5,0,6"
                             MaxLength="20"
                             KeyDown="OnGenerationSeedKeyDown"
                             Text="1"
                             ToolTip="Unsigned 64-bit seed (up to 20 digits)." />
                    <WrapPanel Margin="0,0,0,12">
                        <Button Click="OnApplySeedClick"
                                Content="Apply Seed" />
                        <Button Click="OnRandomizeSeedClick"
                                Content="New Variation" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overall height" />
                        <TextBlock x:Name="OverallHeightValueTextBlock"
                                   Grid.Column="1"
                                   Foreground="#AEB6C2"
                                   Text="256 units" />
                    </Grid>
                    <Slider x:Name="OverallHeightSlider" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Trunk width" />
                        <TextBlock x:Name="TrunkWidthValueTextBlock"
                                   Grid.Column="1"
                                   Foreground="#AEB6C2"
                                   Text="32 units" />
                    </Grid>
                    <Slider x:Name="TrunkWidthSlider" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Canopy width" />
                        <TextBlock x:Name="CanopyWidthValueTextBlock"
                                   Grid.Column="1"
                                   Foreground="#AEB6C2"
                                   Text="160 units" />
                    </Grid>
                    <Slider x:Name="CanopyWidthSlider" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Canopy height" />
                        <TextBlock x:Name="CanopyHeightValueTextBlock"
                                   Grid.Column="1"
                                   Foreground="#AEB6C2"
                                   Text="128 units" />
                    </Grid>
                    <Slider x:Name="CanopyHeightSlider" />

                    <TextBlock Text="Canopy layers / complexity" />
                    <ComboBox x:Name="CanopyLayerCountComboBox" />

                    <TextBlock Text="Grid spacing" />
                    <ComboBox x:Name="GridSpacingComboBox" />

                    <TextBlock Text="Trunk texture" />
                    <TextBox x:Name="TrunkTextureTextBox"
                             KeyDown="OnTextureNameKeyDown"
                             Text="WOOD" />

                    <TextBlock Text="Canopy texture" />
                    <TextBox x:Name="CanopyTextureTextBox"
                             KeyDown="OnTextureNameKeyDown"
                             Text="LEAF" />

                    <Button HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Click="OnApplyTextureNamesClick"
                            Content="Apply Texture Names" />

                    <WrapPanel Margin="0,8,0,0">
                        <Button Click="OnRandomTreeClick"
                                Content="Random Tree" />
                        <Button Click="OnResetToDefaultsClick"
                                Content="Reset to Defaults" />
                        <Button x:Name="ExportButton"
                                Click="OnExportClick"
                                Content="Export .map"
                                IsEnabled="False" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="2"
                Background="#0F1114"
                BorderBrush="#383D46"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Viewport3D x:Name="TreePreviewViewport"
                            ClipToBounds="True"
                            Focusable="True" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="14"
                        Padding="10,7"
                        IsHitTestVisible="False"
                        Background="#CC202329"
                        CornerRadius="4">
                    <TextBlock Foreground="#D7DCE4"
                               TextAlignment="Right"
                               Text="Left-drag: Orbit&#x0a;Wheel: Zoom&#x0a;Right-drag: Pan&#x0a;Double-click: Reset" />
                </Border>
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="14"
                        Padding="10,7"
                        Background="#CC202329"
                        CornerRadius="4">
                    <TextBlock x:Name="PreviewSummaryTextBlock"
                               Text="Generate a tree to preview its brush geometry." />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,16,0,0"
                Padding="12,9"
                Background="#202329"
                BorderBrush="#383D46"
                BorderThickness="1"
                CornerRadius="5">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#BFC7D2"
                       Text="Ready." />
        </Border>
    </Grid>
</Window>
