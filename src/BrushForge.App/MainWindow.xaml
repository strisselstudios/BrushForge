<Window x:Class="BrushForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrushForge by Strissel"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#17191D">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#262A31" />
            <Setter Property="BorderBrush" Value="#454B55" />
            <Setter Property="CaretBrush" Value="#F5F7FA" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#3B4657" />
            <Setter Property="BorderBrush" Value="#59677B" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,16">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="BrushForge Foliage Generator" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#AEB6C2"
                       Text="Generate real low-complexity brush trees and export them to TrenchBroom-compatible Valve 220 maps." />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.Column="0"
                Padding="16"
                Background="#202329"
                BorderBrush="#383D46"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Tree Parameters" />

                    <TextBlock Margin="0,14,0,0"
                               Text="Generation seed" />
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Margin="8,5,0,12"
                                Click="OnRandomizeSeedClick"
                                Content="Random" />
                        <TextBox x:Name="GenerationSeedTextBox"
                                 Text="1" />
                    </DockPanel>

                    <TextBlock Text="Overall height" />
                    <TextBox x:Name="OverallHeightTextBox"
                             Text="256" />

                    <TextBlock Text="Trunk width" />
                    <TextBox x:Name="TrunkWidthTextBox"
                             Text="32" />

                    <TextBlock Text="Canopy width" />
                    <TextBox x:Name="CanopyWidthTextBox"
                             Text="160" />

                    <TextBlock Text="Canopy height" />
                    <TextBox x:Name="CanopyHeightTextBox"
                             Text="128" />

                    <TextBlock Text="Canopy layers / complexity" />
                    <TextBox x:Name="CanopyLayerCountTextBox"
                             Text="3" />

                    <TextBlock Text="Grid spacing" />
                    <TextBox x:Name="GridSpacingTextBox"
                             Text="8" />

                    <TextBlock Text="Trunk texture" />
                    <TextBox x:Name="TrunkTextureTextBox"
                             Text="WOOD" />

                    <TextBlock Text="Canopy texture" />
                    <TextBox x:Name="CanopyTextureTextBox"
                             Text="LEAF" />

                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <Button Click="OnGenerateClick"
                                Content="Generate Tree" />
                        <Button x:Name="ExportButton"
                                Click="OnExportClick"
                                Content="Export .map"
                                IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="2"
                Background="#0F1114"
                BorderBrush="#383D46"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Viewport3D x:Name="TreePreviewViewport"
                            ClipToBounds="True"
                            Focusable="True" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="14"
                        Padding="10,7"
                        IsHitTestVisible="False"
                        Background="#CC202329"
                        CornerRadius="4">
                    <TextBlock Foreground="#D7DCE4"
                               TextAlignment="Right"
                               Text="Left-drag: Orbit&#x0a;Wheel: Zoom&#x0a;Right-drag: Pan&#x0a;Double-click: Reset" />
                </Border>
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="14"
                        Padding="10,7"
                        Background="#CC202329"
                        CornerRadius="4">
                    <TextBlock x:Name="PreviewSummaryTextBlock"
                               Text="Generate a tree to preview its brush geometry." />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,16,0,0"
                Padding="12,9"
                Background="#202329"
                BorderBrush="#383D46"
                BorderThickness="1"
                CornerRadius="5">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#BFC7D2"
                       Text="Ready." />
        </Border>
    </Grid>
</Window>
